{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "CATPILOT_EVIDENCE_LOG=\"$HOME/.catpilot-guardrails/evidence.jsonl\" python3 \"/Library/Application Support/ClaudeCode/catpilot-guardrails/hooks/pretooluse-secrets.py\" --evidence-default",
            "timeout": 10,
            "onFailure": "block"
          },
          {
            "type": "command",
            "command": "CATPILOT_EVIDENCE_LOG=\"$HOME/.catpilot-guardrails/evidence.jsonl\" python3 \"/Library/Application Support/ClaudeCode/catpilot-guardrails/hooks/pretooluse-destructive-ops.py\" --evidence-default",
            "timeout": 10,
            "onFailure": "block"
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "CATPILOT_EVIDENCE_LOG=\"$HOME/.catpilot-guardrails/evidence.jsonl\" python3 \"/Library/Application Support/ClaudeCode/catpilot-guardrails/hooks/pretooluse-write-secrets.py\" --evidence-default",
            "timeout": 10,
            "onFailure": "block"
          }
        ]
      }
    ]
  },
  "managedMcpServers": {
    "catpilot-guardrails": {
      "type": "http",
      "url": "https://mcp.example.com/mcp"
    }
  }
}
